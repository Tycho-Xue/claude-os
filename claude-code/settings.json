{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(pwd)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "(cd ~/claude_config || exit 0; git rebase --abort; git add -A; git diff --cached --quiet || git commit -m \"auto-sync $(date +%Y-%m-%d-%H%M)\"; git fetch origin || exit 0; git rebase origin/main || { git rebase --abort; exit 0; }; git push) >/dev/null 2>&1 &"
          }
        ]
      }
    ]
  },
  "env": {
    "BASH_ENV": "{{path_to_shell_init}}"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
